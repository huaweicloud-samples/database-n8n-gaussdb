# n8n + GaussDB 部署 .env 模板
# 复制本文件为 .env，按需修改

# ===== n8n 加密密钥（必填，否则每次重启 credentials 失效）=====
# 首次启动前生成一个随机字符串，如：openssl rand -hex 32
N8N_ENCRYPTION_KEY=请替换为随机字符串

# ===== n8n 监听 =====
N8N_HOST=0.0.0.0
N8N_PORT=5678

# ===== n8n 自身元数据库 =====
# 默认 SQLite（开箱即用，无需以下配置）
# 本次 GaussDB 适配未实现 n8n 自身库跑 GaussDB，自身库用 SQLite 或 PostgreSQL
# 若用 PostgreSQL 作自身库（非 GaussDB），取消注释：
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=127.0.0.1
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=
# DB_POSTGRESDB_SCHEMA=public

# ===== GaussDB 连接（不在 .env 配，在 n8n UI Credentials 配）=====
# GaussDb 数据库节点：UI → Credentials → "GaussDB" → 填 host/port/database/user/password/ssl
# 向量节点：UI → Credentials → "Postgres"（指向 GaussDB）
# 详见 配置文档.md

# ===== 时区（可选）=====
GENERIC_TIMEZONE=Asia/Shanghai
